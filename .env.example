# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/school_chatbot
# Redis
REDIS_URL=redis://localhost:6379/0

# CORS (Required for separate Next.js Frontend)
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# JWT Auth
JWT_SECRET=super_secret_key_change_me_in_prod
JWT_EXPIRY_MINUTES=60

# LLM Configuration (Choose between: openai, groq, gemini, nvidia)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
RERANKER_CHOICE=cohere

# LLM API Keys (Only the one matching LLM_PROVIDER is required, others will act as automatic fallbacks if provided)
OPENAI_API_KEY=your_openai_api_key
GROQ_API_KEY=your_groq_api_key
GOOGLE_API_KEY=your_gemini_api_key
NVIDIA_API_KEY=your_nvidia_api_key

# LangSmith Tracing & Evals
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langchain_api_key
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_PROJECT=school_chatbot_dev
LANGCHAIN_EVAL_PROJECT=school_chatbot_eval

# RAG & Application settings
CACHE_SIMILARITY_THRESHOLD=0.9
RETRIEVAL_TOP_K=5
CONFIDENCE_THRESHOLD=0.75
EVAL_THRESHOLDS=0.8
